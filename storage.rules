rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Roles are Firebase Auth custom claims (scripts/set-role.mjs). Lab staff
    // upload result files into the owning patient's folder.
    function isLabStaff() {
      return isSignedIn()
        && 'role' in request.auth.token
        && (request.auth.token.role == 'lab_admin' || request.auth.token.role == 'admin');
    }

    function isAdmin() {
      return isSignedIn() && 'role' in request.auth.token && request.auth.token.role == 'admin';
    }

    function isValidResultFile() {
      return request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
    }

    // Patient result files, scoped by owner uid.
    match /results/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isLabStaff());
      allow create, update: if isSignedIn()
        && (request.auth.uid == userId || isLabStaff())
        && isValidResultFile();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isLabStaff());
    }

    // Courier verification documents (government ID, driver's license).
    match /couriers/{userId}/documents/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidResultFile();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Collector verification documents (government ID, license, qualifications).
    // The collector uploads their own; only they and platform admins can read.
    match /collectors/{userId}/documents/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidResultFile();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Legacy self-upload path (pre-hardening files). Read-only; existing
    // documents keep working via their tokened download URLs.
    match /uploads/{fileName} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Everything else: denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
