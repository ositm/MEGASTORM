# Server-side (set real values locally / in Vercel; never commit them)
# GOOGLE_API_KEY=<gemini key>                         # AI result interpreter
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<maps key>          # lab map / places
# FIREBASE_SERVICE_ACCOUNT=<base64 service-account>   # Admin SDK (order writes)
