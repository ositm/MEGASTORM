rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Roles are Firebase Auth custom claims, granted only via
    // scripts/set-role.mjs (Admin API). The role field on users/{uid} is a
    // display mirror and carries no authority here.
    function hasRole(r) {
      return isSignedIn()
        && 'role' in request.auth.token
        && request.auth.token.role == r;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isLabAdmin() {
      return hasRole('lab_admin');
    }

    function isLabAdminFor(labId) {
      return isLabAdmin()
        && 'labId' in request.auth.token
        && request.auth.token.labId == labId;
    }

    function isCollector() {
      return hasRole('collector');
    }

    function isDispatch() {
      return hasRole('dispatch');
    }

    // ---------- Users ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // New accounts may only be created for yourself, as a plain user.
      allow create: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && !('labId' in request.resource.data);
      // Owners may edit their profile but never their own role or lab binding.
      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'labId']));
      allow delete: if isAdmin();
    }

    // ---------- Labs & catalog (public read, admin-managed) ----------
    match /labs/{labId} {
      allow read: if true;
      allow update: if isAdmin() || isLabAdminFor(labId);
      allow create, delete: if isAdmin();

      // Staff roster is managed server-side (Admin SDK grants the claim);
      // only the lab's admin and platform admins can read it.
      match /staff/{staffUid} {
        allow read: if isLabAdminFor(labId) || isAdmin();
        allow write: if false;
      }
    }

    match /labTests/{testId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testPackages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Bookings ----------
    match /bookings/{bookingId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isOwner(resource.data.userId)
        || isLabAdminFor(resource.data.labId)
        || isAdmin();
      allow update: if isLabAdminFor(resource.data.labId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- Orders (schema v2) ----------
    // Written exclusively by the server (Admin SDK bypasses these rules).
    // Clients read their own slice; the events subcollection is the
    // append-only chain of custody with patientId/labId denormalized on.
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.patientId)
        || isLabAdminFor(resource.data.labId)
        || isAdmin();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isOwner(resource.data.patientId)
          || isLabAdminFor(resource.data.labId)
          || isAdmin();
        allow write: if false;
      }
    }

    // ---------- Collectors ----------
    // A collector owns their profile and uploads documents for review.
    // Verification status is set only by the server/admin (never self-granted).
    match /collectors/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.verificationStatus == 'unverified';
      // Owners edit their profile and may submit for review (set
      // verificationStatus to 'pending_review'), but never self-verify or
      // touch their rating. 'verified'/'rejected' are admin-only.
      allow update: if isAdmin()
        || (isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus'])
                || request.resource.data.verificationStatus == 'pending_review'));
      allow delete: if isAdmin();

      match /documents/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && request.resource.data.status == 'pending';
        allow update, delete: if isAdmin();
      }
    }

    // ---------- Jobs (home-collection work) ----------
    // Written only by the server (Admin SDK). Collectors see open jobs and
    // their own; the patient sees the job for their order (tracking).
    match /jobs/{jobId} {
      allow read: if isAdmin()
        || (isCollector()
            && (resource.data.status in ['pending', 'offered']
                || resource.data.collectorId == request.auth.uid))
        || (isDispatch()
            && (resource.data.status == 'handed_over'
                || resource.data.dispatchId == request.auth.uid))
        || isOwner(resource.data.patientId);
      // The assigned collector may update ONLY their live location; all
      // custody-affecting fields remain server-only (Admin SDK).
      allow update: if isSignedIn()
        && resource.data.collectorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['collectorLocation', 'locationUpdatedAt']);
      allow create, delete: if false;
    }

    // ---------- Results ----------
    match /results/{resultId} {
      allow create: if isSignedIn()
        && (request.resource.data.userId == request.auth.uid
            || isLabAdminFor(request.resource.data.labId)
            || isAdmin());
      allow read: if isOwner(resource.data.userId)
        || isLabAdminFor(resource.data.labId)
        || isAdmin();
      // Owner updates cover AI-analysis status writes from the patient app.
      allow update: if isOwner(resource.data.userId)
        || isLabAdminFor(resource.data.labId)
        || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ---------- Notifications ----------
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Users may only mark their own notifications as read.
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isLabAdmin() || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ---------- Reminders ----------
    match /reminders/{reminderId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // ---------- Lab ownership claims ----------
    match /lab_claims/{claimId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------- Public waiting list (write-only drop box) ----------
    match /waitingList/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'type', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.name is string
        && request.resource.data.name.size() < 200
        && request.resource.data.message is string
        && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // ---------- Everything else: denied ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
